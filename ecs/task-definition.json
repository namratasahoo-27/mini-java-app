{
  "family": "mini-java-app-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "mini-java-app",
      "image": "{{IMAGE_URI}}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "SERVER_PORT",
          "value": "8080"
        },
        {
          "name": "SERVER_HOST",
          "value": "0.0.0.0"
        },
        {
          "name": "JAVA_OPTS",
          "value": "-Xmx512m -Xms256m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"
        },
        {
          "name": "ENVIRONMENT",
          "value": "production"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "DATABASE_URL",
          "value": "{{DATABASE_URL}}"
        },
        {
          "name": "DB_USERNAME",
          "value": "{{DB_USERNAME}}"
        },
        {
          "name": "DB_PASSWORD",
          "value": "{{DB_PASSWORD}}"
        },
        {
          "name": "REDIS_HOST",
          "value": "{{REDIS_HOST}}"
        },
        {
          "name": "REDIS_PORT",
          "value": "6379"
        },
        {
          "name": "EXTERNAL_API_URL",
          "value": "{{EXTERNAL_API_URL}}"
        },
        {
          "name": "PAYMENT_SERVICE_URL",
          "value": "{{PAYMENT_SERVICE_URL}}"
        },
        {
          "name": "MONITORING_ENDPOINT",
          "value": "{{MONITORING_ENDPOINT}}"
        },
        {
          "name": "RABBITMQ_HOST",
          "value": "{{RABBITMQ_HOST}}"
        },
        {
          "name": "RABBITMQ_PORT",
          "value": "5672"
        },
        {
          "name": "RABBITMQ_USERNAME",
          "value": "{{RABBITMQ_USERNAME}}"
        },
        {
          "name": "RABBITMQ_PASSWORD",
          "value": "{{RABBITMQ_PASSWORD}}"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mini-java-app",
          "awslogs-region": "{{AWS_REGION}}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "mountPoints": [],
      "volumesFrom": []
    }
  ],
  "volumes": []
}
