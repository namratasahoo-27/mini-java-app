# Environment Variables Template for Mini App
# Copy this file to .env and populate with actual values
# NEVER commit .env file to version control

# Server Configuration
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0
APP_NAME=mini-app

# PostgreSQL Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/mini_app_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_secure_password_here

# Database Connection Pool Settings
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# JPA/Hibernate Settings
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Flyway Migration Settings
FLYWAY_ENABLED=true

# Redis Cache Configuration
CACHE_TYPE=redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=60000

# External API Configuration
EXTERNAL_API_BASE_URL=http://api.example.com:8080/v1
EXTERNAL_API_TIMEOUT=30000
EXTERNAL_API_KEY=your_api_key_here

# Payment Service Configuration
PAYMENT_SERVICE_URL=https://payment.internal.company.com/process
PAYMENT_SERVICE_USERNAME=
PAYMENT_SERVICE_PASSWORD=

# File Paths (relative to application directory)
APP_CONFIG_DIR=./config
APP_LOG_DIR=./logs
APP_TEMP_DIR=./temp
APP_UPLOAD_DIR=./uploads

# Security Configuration (Use Secrets Manager in Production)
JWT_SECRET=your_jwt_secret_here
ADMIN_USERNAME=
ADMIN_PASSWORD=
ENCRYPTION_KEY=

# Health Check Configuration
HEALTH_SHOW_DETAILS=when-authorized

# Monitoring Configuration
MONITORING_ENDPOINT=http://monitoring.internal.company.com:9090/metrics
MONITORING_USERNAME=
MONITORING_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Application Profile
SPRING_PROFILES_ACTIVE=dev

# Logging Levels
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=DEBUG
